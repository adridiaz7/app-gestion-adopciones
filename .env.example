# Copia este archivo como .env (desarrollo) y rellena tus valores.
# .env y .env.test no se suben a git.

# Puerto del servidor Express
PORT=3000

# Opcional. Dirección pública de la app, para los enlaces de los emails.
# Si no se pone, se usa http://localhost:<PORT>.
# PUBLIC_URL=https://adopciones.example

# Conexión a PostgreSQL (los usuarios de desarrollo están en database/README.md)
PGHOST=localhost
PGPORT=5432
PGDATABASE=adopciones
PGUSER=cambia_esto
PGPASSWORD=cambia_esto
