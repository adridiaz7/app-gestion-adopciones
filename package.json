{
  "name": "app-gestion-adopciones",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma web de adopción de mascotas: solicitudes, visitas y adopciones.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build:client && tsx watch --env-file=.env src/server/server.ts",
    "dev:client": "tsc -p tsconfig.client.json --watch",
    "build": "tsc -p tsconfig.server.json && npm run build:client",
    "build:client": "tsc -p tsconfig.client.json",
    "start": "node --env-file=.env dist/server/server.js",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:auth": "vitest run tests/unit/auth tests/integration/auth",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
